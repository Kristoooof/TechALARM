# Másold .env.local néven, és töltsd ki. A Vercelben ugyanezeket add meg (Settings > Environment Variables).

# Supabase (Project Settings > API) – ez a kettő publikus kulcs, nyugodtan látszhat a böngészőben
NEXT_PUBLIC_SUPABASE_URL=https://igtzmnpbizcfpwhqxqnd.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_gTybopVhieQ-ZzFEZQmxzQ_coXXGyFE

# TITOK! Csak a szerveren használjuk (Project Settings > API > service_role / secret key). Soha ne tedd NEXT_PUBLIC_ elé.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile (spamvédelem). Fejlesztéshez ezek a Cloudflare-féle teszt kulcsok (mindig átengednek):
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Tetszőleges hosszú véletlen szöveg: ezzel hash-eljük az IP-címeket (a nyers IP-t nem tároljuk)
IP_HASH_SALT=
